{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal: apenas eventos e os comandos do NEXUS. Sem fs, shell ou http.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-get-startup-status",
    "allow-check-for-update",
    "allow-install-update",
    "allow-get-app-info",
    "allow-get-diagnostics",
    "allow-run-integrity-check",
    "allow-list-operations",
    "allow-get-settings",
    "allow-set-setting",
    "allow-reveal-data-dir",
    "allow-list-projects",
    "allow-get-project-overview",
    "allow-pick-project-folder",
    "allow-add-project",
    "allow-remove-project",
    "allow-start-index",
    "allow-pause-index",
    "allow-resume-index",
    "allow-cancel-index",
    "allow-get-indexing-queue",
    "allow-list-jobs",
    "allow-get-job-errors",
    "allow-list-skipped-files",
    "allow-touch-project",
    "allow-reveal-project-dir",
    "allow-search-project",
    "allow-get-file-context",
    "allow-compile-context-pack",
    "allow-list-context-packs",
    "allow-get-context-pack",
    "allow-delete-context-pack",
    "allow-render-context-pack",
    "allow-save-context-pack",
    "allow-list-memories",
    "allow-get-memory",
    "allow-get-memory-counts",
    "allow-create-memory",
    "allow-update-memory",
    "allow-transition-memory",
    "allow-review-memory-refs",
    "allow-import-adrs",
    "allow-list-freshness-issues",
    "allow-get-freshness-summary",
    "allow-scan-freshness",
    "allow-set-issue-dismissed",
    "allow-get-integration-info",
    "allow-get-analysis-overview",
    "allow-get-file-analysis",
    "allow-get-project-map",
    "allow-get-file-history"
  ]
}
