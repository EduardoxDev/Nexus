# Copie para .env e preencha. O .env nunca vai para o git.
# Token do bot (Developer Portal → Bot → Reset Token). Nunca cole em chats ou issues.
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information).
DISCORD_APP_ID=
# ID do servidor onde os comandos são registrados (botão direito no servidor → Copiar ID).
DISCORD_GUILD_ID=
# Caminho da CLI da NEXUS (nexus.exe no Windows).
NEXUS_CLI=
# Pasta de dados da NEXUS usada só pelo bot (define quais projetos ele enxerga).
NEXUS_DATA_DIR=
