{
  "name": "nexus-workspace",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm --prefix apps/desktop run tauri:dev",
    "build": "npm --prefix apps/desktop run build",
    "check": "npm --prefix apps/desktop run check",
    "test": "npm --prefix apps/desktop run test",
    "e2e": "npm --prefix apps/desktop run e2e:build && npm --prefix apps/desktop run e2e",
    "bundle": "npm --prefix apps/desktop run tauri:build"
  }
}